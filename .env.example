# ─── Site / Next.js ───────────────────────────────────────────────
# Public origin used as the canonical URL (no trailing slash)
NEXT_PUBLIC_API_URL_ORIGIN=http://localhost:3000

# Optional: your LAN IP so dev server allows connections from other devices
# NEXT_PUBLIC_LOCAL_IP=192.168.1.x

# ─── AI Assistant (local LLM via llama.cpp or LM Studio) ─────────
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_API_KEY=
LLM_MODEL=your-model-filename.gguf

# ─── Contact Form Email (optional — works without SMTP too) ───────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password_here
# CONTACT_TO_EMAIL=your@email.com

# ─── Analytics / Error Tracking (optional) ───────────────────────
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_DSN=
